<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Royal Lux Beauty Club | Where Beauty Meets Royalty</title>
    
    <!-- Premium Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Montserrat:wght@100;200;300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --gold: #c9a84c;
            --gold-light: #e0c878;
            --gold-dark: #8b6914;
            --platinum: #e5e4e2;
            --diamond: #b9f2ff;
            --black: #000000;
            --obsidian: #0a0a0a;
            --charcoal: #111111;
            --cream: #faf8f5;
            --champagne: #f7e7ce;
            --rose-gold: #b76e79;
            --white-gold: #f5f0e0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            cursor: none;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background: var(--black);
            color: #fff;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* Custom Cursor */
        .cursor {
            width: 20px;
            height: 20px;
            border: 2px solid var(--gold);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 99999;
            transition: all 0.1s ease;
            mix-blend-mode: difference;
        }

        .cursor-follower {
            width: 8px;
            height: 8px;
            background: var(--gold);
            border-radius: 50%;
            position: fixed;
            pointer-events: none;
            z-index: 99999;
            transition: all 0.15s ease;
        }

        .cursor-hover {
            width: 50px;
            height: 50px;
            background: rgba(201, 168, 76, 0.1);
            border-color: var(--gold-light);
            transition: all 0.3s ease;
        }

        /* Particle Canvas */
        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        /* Preloader */
        .preloader {
            position: fixed;
            inset: 0;
            background: var(--black);
            z-index: 100000;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 1s cubic-bezier(0.77, 0, 0.175, 1);
        }

        .preloader.hidden {
            opacity: 0;
            pointer-events: none;
        }

        .preloader-content {
            text-align: center;
        }

        .preloader-logo {
            font-family: 'Playfair Display', serif;
            font-size: 4rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--gold), var(--platinum), var(--gold-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: shimmer 2s infinite;
        }

        .preloader-line {
            width: 200px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            margin: 2rem auto;
            animation: pulse 1.5s infinite;
        }

        /* Navigation */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            padding: 1.5rem 4rem;
            transition: all 0.6s cubic-bezier(0.77, 0, 0.175, 1);
            mix-blend-mode: difference;
        }

        .navbar.scrolled {
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(30px);
            -webkit-backdrop-filter: blur(30px);
            padding: 1rem 4rem;
            mix-blend-mode: normal;
            border-bottom: 1px solid rgba(201, 168, 76, 0.1);
        }

        .navbar-inner {
            max-width: 1600px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 900;
            letter-spacing: 0.3em;
            text-decoration: none;
            background: linear-gradient(135deg, var(--gold), var(--platinum));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            position: relative;
        }

        .logo::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            transform: scaleX(0);
            transition: transform 0.5s ease;
        }

        .logo:hover::after {
            transform: scaleX(1);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 3rem;
        }

        .nav-link {
            color: #fff;
            text-decoration: none;
            font-size: 0.75rem;
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            position: relative;
            padding: 0.5rem 0;
            transition: all 0.3s ease;
        }

        .nav-link::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 1px;
            background: var(--gold);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.5s cubic-bezier(0.77, 0, 0.175, 1);
        }

        .nav-link:hover::before {
            transform: scaleX(1);
            transform-origin: left;
        }

        .nav-link:hover {
            color: var(--gold);
        }

        .btn-reserve {
            background: transparent;
            border: 1px solid var(--gold);
            color: var(--gold);
            padding: 0.8rem 2.5rem;
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.77, 0, 0.175, 1);
            position: relative;
            overflow: hidden;
            font-weight: 300;
        }

        .btn-reserve::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(201, 168, 76, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .btn-reserve:hover::before {
            left: 100%;
        }

        .btn-reserve:hover {
            background: var(--gold);
            color: var(--black);
            box-shadow: 0 0 50px rgba(201, 168, 76, 0.3);
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .hero-bg {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at center, rgba(201, 168, 76, 0.05) 0%, transparent 70%);
        }

        .hero-grid {
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(rgba(201, 168, 76, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(201, 168, 76, 0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            animation: gridMove 20s linear infinite;
        }

        @keyframes gridMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(60px, 60px); }
        }

        .hero-content {
            position: relative;
            z-index: 2;
            text-align: center;
            max-width: 1000px;
            padding: 2rem;
        }

        .hero-badge {
            display: inline-block;
            padding: 0.5rem 2rem;
            border: 1px solid rgba(201, 168, 76, 0.3);
            border-radius: 50px;
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 3rem;
            animation: fadeInUp 1s ease-out 0.5s both;
            backdrop-filter: blur(10px);
        }

        .hero-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 8rem;
            font-weight: 300;
            line-height: 1;
            margin-bottom: 1rem;
            animation: fadeInUp 1s ease-out 0.7s both;
            letter-spacing: 0.05em;
        }

        .hero-title .gold {
            background: linear-gradient(135deg, var(--gold), var(--platinum), var(--gold-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 700;
        }

        .hero-subtitle {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 300;
            font-style: italic;
            color: var(--gold);
            margin-bottom: 1rem;
            animation: fadeInUp 1s ease-out 0.9s both;
            letter-spacing: 0.1em;
        }

        .hero-description {
            font-size: 1.1rem;
            font-weight: 200;
            color: #888;
            max-width: 600px;
            margin: 0 auto 4rem;
            line-height: 1.8;
            animation: fadeInUp 1s ease-out 1.1s both;
            letter-spacing: 0.05em;
        }

        .hero-cta {
            display: flex;
            gap: 2rem;
            justify-content: center;
            animation: fadeInUp 1s ease-out 1.3s both;
            flex-wrap: wrap;
        }

        .btn-primary {
            padding: 1.2rem 3rem;
            font-size: 0.75rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            font-weight: 400;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.77, 0, 0.175, 1);
            position: relative;
            overflow: hidden;
            text-decoration: none;
            display: inline-block;
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--gold-dark), var(--gold), var(--gold-light));
            color: var(--black);
            border: none;
        }

        .btn-gold:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 60px rgba(201, 168, 76, 0.4);
        }

        .btn-outline {
            background: transparent;
            border: 1px solid rgba(201, 168, 76, 0.3);
            color: var(--gold);
        }

        .btn-outline:hover {
            border-color: var(--gold);
            background: rgba(201, 168, 76, 0.05);
            box-shadow: 0 20px 60px rgba(201, 168, 76, 0.1);
        }

        /* Scroll Indicator */
        .scroll-indicator {
            position: absolute;
            bottom: 3rem;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            animation: fadeInUp 1s ease-out 1.5s both;
        }

        .scroll-line {
            width: 1px;
            height: 60px;
            background: linear-gradient(to bottom, var(--gold), transparent);
            animation: scrollLine 2s infinite;
        }

        .scroll-text {
            font-size: 0.6rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: #666;
        }

        @keyframes scrollLine {
            0%, 100% { transform: scaleY(1); transform-origin: top; }
            50% { transform: scaleY(0.3); transform-origin: top; }
        }

        /* Sections */
        .section {
            padding: 10rem 4rem;
            position: relative;
            z-index: 2;
        }

        .section-header {
            text-align: center;
            margin-bottom: 6rem;
        }

        .section-tag {
            font-size: 0.7rem;
            letter-spacing: 0.4em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 1.5rem;
            font-weight: 300;
        }

        .section-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 4rem;
            font-weight: 300;
            line-height: 1.2;
            margin-bottom: 1.5rem;
            letter-spacing: 0.05em;
        }

        .section-title .accent {
            background: linear-gradient(135deg, var(--gold), var(--platinum));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 700;
            font-style: italic;
        }

        .section-line {
            width: 100px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--gold), transparent);
            margin: 2rem auto;
        }

        .section-description {
            font-size: 1.1rem;
            font-weight: 200;
            color: #777;
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.8;
            letter-spacing: 0.05em;
        }

        /* Services Grid */
        .services-showcase {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 2px;
            background: rgba(201, 168, 76, 0.1);
        }

        .service-showcase-item {
            background: var(--obsidian);
            padding: 4rem 3rem;
            position: relative;
            overflow: hidden;
            transition: all 0.6s cubic-bezier(0.77, 0, 0.175, 1);
        }

        .service-showcase-item::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center, rgba(201, 168, 76, 0.1) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.6s ease;
        }

        .service-showcase-item:hover::before {
            opacity: 1;
        }

        .service-showcase-item:hover {
            transform: translateY(-10px);
            background: var(--charcoal);
        }

        .service-number {
            font-family: 'Playfair Display', serif;
            font-size: 4rem;
            font-weight: 900;
            color: rgba(201, 168, 76, 0.05);
            position: absolute;
            top: 2rem;
            right: 2rem;
            transition: all 0.6s ease;
        }

        .service-showcase-item:hover .service-number {
            color: rgba(201, 168, 76, 0.1);
            transform: scale(1.2);
        }

        .service-icon-large {
            font-size: 3rem;
            margin-bottom: 2rem;
            display: block;
        }

        .service-name-large {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 400;
            margin-bottom: 1rem;
            color: #fff;
        }

        .service-desc {
            color: #777;
            font-size: 0.9rem;
            line-height: 1.8;
            margin-bottom: 2rem;
            font-weight: 300;
        }

        .service-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 2rem;
            border-top: 1px solid rgba(201, 168, 76, 0.1);
        }

        .service-price {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            color: var(--gold);
        }

        .service-duration {
            font-size: 0.8rem;
            color: #666;
            letter-spacing: 0.1em;
        }

        /* Products Grid */
        .products-masonry {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 3rem;
        }

        .product-showcase {
            position: relative;
            overflow: hidden;
            border-radius: 0;
            background: var(--charcoal);
            transition: all 0.6s cubic-bezier(0.77, 0, 0.175, 1);
        }

        .product-showcase:hover {
            transform: translateY(-10px);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
        }

        .product-image-container {
            width: 100%;
            height: 400px;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #1a1a1a, #2a2a2a);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 6rem;
        }

        .product-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
            display: flex;
            align-items: flex-end;
            padding: 2rem;
            opacity: 0;
            transition: all 0.5s ease;
        }

        .product-showcase:hover .product-overlay {
            opacity: 1;
        }

        .product-info-large {
            padding: 2rem;
        }

        .product-brand {
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--gold);
            margin-bottom: 0.5rem;
            font-weight: 300;
        }

        .product-title {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.4rem;
            font-weight: 400;
            margin-bottom: 1rem;
            color: #fff;
        }

        .product-pricing {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .product-current-price {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--gold);
        }

        .product-original-price {
            font-size: 0.9rem;
            color: #555;
            text-decoration: line-through;
        }

        .product-badge {
            position: absolute;
            top: 1.5rem;
            left: 1.5rem;
            background: var(--gold);
            color: var(--black);
            padding: 0.5rem 1.5rem;
            font-size: 0.65rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            font-weight: 600;
            z-index: 2;
        }

        /* Membership Cards */
        .membership-collection {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 3rem;
            align-items: center;
        }

        .membership-card-premium {
            background: var(--charcoal);
            padding: 4rem 3rem;
            position: relative;
            transition: all 0.6s cubic-bezier(0.77, 0, 0.175, 1);
            border: 1px solid rgba(201, 168, 76, 0.1);
        }

        .membership-card-premium.featured {
            background: linear-gradient(135deg, var(--gold-dark), var(--gold), var(--gold-light));
            color: var(--black);
            transform: scale(1.05);
            border: none;
            box-shadow: 0 30px 80px rgba(201, 168, 76, 0.3);
        }

        .membership-card-premium:hover {
            transform: translateY(-10px);
        }

        .membership-card-premium.featured:hover {
            transform: scale(1.05) translateY(-10px);
        }

        .featured-badge {
            position: absolute;
            top: -1rem;
            left: 50%;
            transform: translateX(-50%);
            background: var(--black);
            color: var(--gold);
            padding: 0.5rem 2rem;
            font-size: 0.65rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            font-weight: 600;
        }

        .membership-tier-name {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
            text-align: center;
        }

        .membership-tier-subtitle {
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: 3rem;
            opacity: 0.7;
        }

        .membership-price-large {
            font-family: 'Playfair Display', serif;
            font-size: 4rem;
            font-weight: 900;
            text-align: center;
            margin-bottom: 3rem;
        }

        .membership-price-large .currency {
            font-size: 1.5rem;
            vertical-align: super;
        }

        .membership-price-large .period {
            font-size: 1rem;
            font-weight: 300;
            opacity: 0.5;
        }

        .benefits-list-premium {
            list-style: none;
            margin-bottom: 3rem;
        }

        .benefit-item-premium {
            padding: 1rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            font-size: 0.9rem;
            font-weight: 300;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .membership-card-premium.featured .benefit-item-premium {
            border-bottom-color: rgba(0, 0, 0, 0.1);
        }

        .benefit-icon {
            color: var(--gold);
            font-weight: 700;
        }

        .membership-card-premium.featured .benefit-icon {
            color: var(--black);
        }

        .btn-membership {
            width: 100%;
            padding: 1.2rem;
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.5s ease;
            border: 1px solid rgba(201, 168, 76, 0.3);
            background: transparent;
            color: var(--gold);
        }

        .membership-card-premium.featured .btn-membership {
            background: var(--black);
            color: var(--gold);
            border: none;
        }

        .btn-membership:hover {
            background: var(--gold);
            color: var(--black);
            border-color: var(--gold);
        }

        /* Stats Section */
        .stats-showcase {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            padding: 6rem 0;
            border-top: 1px solid rgba(201, 168, 76, 0.1);
            border-bottom: 1px solid rgba(201, 168, 76, 0.1);
        }

        .stat-item-premium {
            text-align: center;
            padding: 2rem;
        }

        .stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--gold), var(--platinum));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 0.5rem;
        }

        .stat-label-premium {
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: #666;
            font-weight: 300;
        }

        /* Testimonials */
        .testimonial-card {
            background: var(--charcoal);
            padding: 4rem;
            position: relative;
            max-width: 800px;
            margin: 0 auto;
            text-align: center;
        }

        .testimonial-quote {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            font-style: italic;
            line-height: 1.8;
            color: #bbb;
            margin-bottom: 2rem;
            font-weight: 300;
        }

        .testimonial-author {
            font-family: 'Playfair Display', serif;
            color: var(--gold);
            font-weight: 600;
        }

        .testimonial-role {
            font-size: 0.7rem;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: #666;
            margin-top: 0.5rem;
        }

        .quote-mark {
            font-family: 'Playfair Display', serif;
            font-size: 8rem;
            color: rgba(201, 168, 76, 0.05);
            position: absolute;
            top: -2rem;
            left: 2rem;
            line-height: 1;
        }

        /* Booking Section */
        .booking-showcase {
            max-width: 700px;
            margin: 0 auto;
            background: var(--charcoal);
            padding: 5rem;
            border: 1px solid rgba(201, 168, 76, 0.1);
        }

        .form-group-premium {
            margin-bottom: 2rem;
        }

        .form-label-premium {
            display: block;
            font-size: 0.7rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: #888;
            margin-bottom: 0.8rem;
